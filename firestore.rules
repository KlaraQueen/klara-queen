rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'kulpinska.karolinaa@gmail.com';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Oferty — każdy może czytać, tylko admin może pisać
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Zamówienia — admin widzi wszystkie, klient widzi tylko swoje
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if (
                      // Zakup zalogowanego użytkownika
                      (request.auth != null && request.resource.data.userId == request.auth.uid)
                      // Zakup jako gość (bez logowania)
                      || (
                        request.auth == null
                        && request.resource.data.userId == 'guest'
                        && request.resource.data.customerEmail is string
                        && request.resource.data.customerName is string
                        && request.resource.data.offerId is string
                        && request.resource.data.offerTitle is string
                        && request.resource.data.price is string
                        && request.resource.data.paymentProvider is string
                        && request.resource.data.paymentType is string
                        && request.resource.data.status is string
                      )
                    );
      allow update: if request.auth != null
                    && (
                      isAdmin()
                      || (
                        request.auth.uid == resource.data.userId
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['cancellationRequested', 'cancellationRequestedAt', 'subscriptionStatus', 'updatedAt'])
                      )
                    );
    }

    // Profile użytkowników — każdy widzi/edytuje tylko swoje
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Faktury — admin zarządza; klient czyta tylko swoje (userId lub ten sam email co w Firebase Auth)
    match /invoices/{invoiceId} {
      allow read: if isAdmin()
                  || resource.data.userId == request.auth.uid
                  || (
                    request.auth.token.email != null
                    && resource.data.customerEmail == request.auth.token.email
                  );
      allow write: if isAdmin();
    }
  }
}
